<table class="table aman-posts-table">
<thead>
<tr><th>Date</th><th>Title</th><th>Categories</th></tr>
</thead>
<tbody>
<% for (const item of items) { %>
  <% const href = item['external-url'] || item.path; %>
  <tr>
    <td class="listing-date"><%= item.date %></td>
    <td><a href="<%- href %>"<% if (item['external-url']) { %> target="_blank" rel="noopener"<% } %>><%= item.title %></a></td>
    <td class="listing-categories"><%= (item.categories || []).join(", ") %></td>
  </tr>
<% } %>
</tbody>
</table>
